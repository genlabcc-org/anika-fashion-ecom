{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/product/:productId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|twitterbot|Instagram|TelegramBot|LinkedInBot|Slackbot).*"
        }
      ],
      "destination": "/api/og?productId=:productId"
    },
    { 
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
