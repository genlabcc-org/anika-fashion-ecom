{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/product/:productId",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|meta-externalagent|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Pinterest|Discordbot).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "from",
          "value": "preview"
        }
      ],
      "destination": "/api/og?productId=:productId"
    },
    { 
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
