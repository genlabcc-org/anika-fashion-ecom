# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
build/
dist/ 

# misc
.DS_Store
.vscode

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# developemnt
graphify-out/

# Supabase
.branches
.temp

# dotenvx
.env
.env.keys
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Terraform
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and secrets. These should not be part of version 
# control as they are data points which are passed in at runtime or variables.
*.tfvars
*.tfvars.json

# Ignore override files as they are local-only overrides to resources due to local dev
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore the plan output of terraform
*.tfplan

# Ignore CLI config files
.terraformrc
terraform.rc
.terraform.lock.hcl

# Icarry Docs
icarry_api_v16_extracted.txt
icarry-api new 16.00.pdf